# MONGODB_URI: Connection string for MongoDB database.
# AI Studio injects user secrets into process.env at runtime.
MONGODB_URI="mongodb+srv://..."
MONGODB_URL=""
MONGO_URI=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================
# BASE PAY CONFIGURATION
# =========================================================
NEXT_PUBLIC_PAYMENT_ADDRESS=0xAbF6dc8D749Ffca0013535888c7Fd6551001b4D0
NEXT_PUBLIC_BASEPAY_TESTNET=true
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=84532

# =========================================================
# MOZAMBIQUE PAYMENT GATEWAYS CREDENTIALS (M-Pesa & Cards)
# =========================================================

# 1. VODACOM M-PESA MOÇAMBIQUE C2B API
# Sign up & obtain API keys at: https://developer.mpesa.vm.co.mz or https://apix.voda.co.mz
MPESA_ENVIRONMENT="sandbox" # Options: sandbox | production
MPESA_API_KEY="" # OpenAPI key from Vodacom Developer Portal
MPESA_PUBLIC_KEY="" # Public Key for RSA encryption of Security Credential
MPESA_SERVICE_PROVIDER_CODE="171717" # C2B Shortcode / Entidade (e.g. 171717 or 88888)
MPESA_INITIATOR_IDENTIFIER="" # Authorized Initiator ID from Vodacom
MPESA_SECURITY_CREDENTIAL="" # Encrypted Security Credential / PIN

# 2. MOZAMBIQUE CARD PAYMENT GATEWAY (Visa / Mastercard / SIMO Rede)
# Option A: Flutterwave (Supports Metical MZN, M-Pesa, & Visa/Mastercard)
# Sign up & obtain keys at: https://flutterwave.com
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""

# Option B: PayShed Moçambique / DPO Pay (Native Mozambique Acquirer for SIMO & Visa/Mastercard)
# Sign up & obtain keys at: https://payshed.co.mz or https://www.dpogroup.com
PAYSHED_API_KEY=""
PAYSHED_ACCOUNT_ID=""
DPO_COMPANY_TOKEN=""

# =========================================================
# 3. DEBITO PAY PAYMENT GATEWAY (REST API v1)
# =========================================================
