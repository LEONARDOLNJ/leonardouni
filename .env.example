DEBITOPAY_BASE_URL="https://debitopay.com"
DEBITOPAY_MERCHANT_ID="debito_merch_sandbox_mz_2026"
DEBITOPAY_API_KEY="debito_sk_test_98f7a8b2c4e10d6a"
